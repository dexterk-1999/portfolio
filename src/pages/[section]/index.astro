---
import Base from '../../layouts/Base.astro';
import EntryCard from '../../components/EntryCard.astro';
import site from '../../data/site.json';
import newsletter from '../../data/newsletter.json';
import { sections, entriesFor } from '../../lib/sections';

export function getStaticPaths() {
  return sections.filter((s) => s.collection).map((s) => ({ params: { section: s.slug }, props: { section: s } }));
}
const { section } = Astro.props;
const entries = await entriesFor(section.collection);
const field = section.key === 'outdoors';
---
<Base title={section.title} description={section.intro} theme={field ? 'field' : 'paper'}>
  <div class={`wrap ${field ? 'field' : ''}`} style={field ? 'background:transparent' : undefined}>
    <div class="sec" style="padding-top:clamp(32px,5vw,64px)">
      <div class="sec-head"><span class="n">{section.n}</span><h1 class="page-title">{section.title}</h1></div>
      <p class="lede">{section.intro}</p>

      {section.key === 'writing' && (
        <div class="feature">
          <div class="main">
            <span class="tag">Newsletter</span>
            <h3><a href={site.newsletter} rel="noopener">Fragments of Insights</a></h3>
            <p>Essays and observations, published on LinkedIn. Each article is listed below with a link to the original.</p>
          </div>
          <dl>
            <dt>Read it on</dt><dd><a href={site.newsletter} rel="noopener" style="color:#F2C9B3">LinkedIn</a></dd>
          </dl>
        </div>
      )}

      {section.key === 'writing' && (
        <>
          <h2 class="eyebrow" style="margin-top:48px">All {newsletter.length} newsletter articles</h2>
          <p class="muted" style="margin-top:8px">Each links to the original on LinkedIn. Some titles are reconstructed from the article links and are being checked against the published wording.</p>
          <ol class="rows">
            {newsletter.map((a) => (
              <li><h3><a href={a.url} rel="noopener">{a.title}</a></h3></li>
            ))}
          </ol>
          <h2 class="eyebrow" style="margin-top:48px">Other writing</h2>
        </>
      )}
      <div class="cards">
        {entries.map((e) => <EntryCard entry={e} section={section} image={true} />)}
      </div>
      {entries.length === 0 && <p class="lede">Entries will appear here as they are added.</p>}
    </div>
  </div>
</Base>
