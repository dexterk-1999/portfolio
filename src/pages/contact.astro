---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const enquiries = [
  'Strategic communications opportunities',
  'Consulting and collaborations',
  'Speaking engagements',
  'MC and moderation',
  'Partnerships',
  'Creative projects',
];
---
<Base title="Contact" description="Contact David (Dexter) Kamau about communications work, speaking, MC and moderation, partnerships and creative projects.">
  <div class="wrap sec" style="padding-top:clamp(32px,5vw,64px)">
    <div class="sec-head"><span class="n">09</span><h1 class="page-title">Contact</h1></div>
    <p class="lede">Get in touch about any of these.</p>
    <ul class="rows">
      {enquiries.map((e) => <li><h3>{e}</h3></li>)}
    </ul>

    <div class="contact" style="margin-top:40px">
      <div>
        <h2>Details</h2>
        <p style="margin-top:16px;color:#E4DED0">{site.location}</p>
      </div>
      <div>
        <p><span class="k">Email</span><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <p><span class="k">Phone</span><a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
        <p><span class="k">LinkedIn</span><a href={site.linkedin} rel="noopener">linkedin.com/in/david-kamau-983008350</a></p>
        <p><span class="k">Fragments of Insights</span><a href={site.newsletter} rel="noopener">Read the newsletter on LinkedIn</a></p>
        <p><span class="k">CV and professional profile</span>To supply as PDF</p>
      </div>
    </div>
  </div>
</Base>
